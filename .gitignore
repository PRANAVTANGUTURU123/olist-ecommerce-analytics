# Raw and derived data are regenerated by the pipeline, not committed.
# (Kaggle's Olist dataset also shouldn't be redistributed in a public repo.)
data/raw/*.csv
data/processed/*.csv
data/processed/*.parquet
data/*.duckdb
sql/results/*.csv

!data/raw/.gitkeep
!data/processed/.gitkeep
!sql/results/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
